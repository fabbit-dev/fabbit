	(title_block
		(title "Fabbit mainboard: FPGA module socket, JTAG, TCXO")
		(date "2026-11-21")
		(company "Fabbit")
		(comment 1 "Colorlight i9+ in TE 1473005-4; contacts 43/45/47/53/187/189 not probed, left open")
		(comment 2 "UHSIF26 on bank 14 (supervisor-pinmap), relocations and new pins CANDIDATE, pin budget short by 5 (LA_DIR4, LOW_REQ_H/L, RANGE_H, FPGA_GEN)")
		(comment 3 "TCXO HCI 8132S 25 MHz -> LVC1GU04 -> LVC2G34 -> H3 + mezzanine; supply 3V3_CLK (TPS7A2033 from 5V_FPGA)")
		(comment 4 "DRAFT, DO NOT POWER")
	)
