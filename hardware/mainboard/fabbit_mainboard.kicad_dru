(version 1)

# Стойки модуля аналога H9…H12 (Würth WA-SMSI 9774090151): площадка 1 касается
# отверстия Ø3,7 самого футпринта. Так в рекомендации Würth.
(rule "Würth WA-SMSI: площадка у своего отверстия"
	(constraint hole_clearance (min 0mm))
	(condition "(A.memberOfFootprint('H9') && B.memberOfFootprint('H9')) || (A.memberOfFootprint('H10') && B.memberOfFootprint('H10')) || (A.memberOfFootprint('H11') && B.memberOfFootprint('H11')) || (A.memberOfFootprint('H12') && B.memberOfFootprint('H12'))"))

# Отверстия Ø3,7 стоек H9…H12 под экраном SCR1 (H9, H10 заходят на 0,55 мм).
# Экран: модуль перед F, на F под ним ничего; стойка и винт со стороны B.
# По механике корпуса, hardware/mainboard/mech/README.md.
(rule "Стойки модуля аналога под экраном"
	(constraint courtyard_clearance (min -0.01mm))
	(condition "((A.Reference == 'H9' || A.Reference == 'H10' || A.Reference == 'H11' || A.Reference == 'H12') && B.Reference == 'SCR1') || (A.Reference == 'SCR1' && (B.Reference == 'H9' || B.Reference == 'H10' || B.Reference == 'H11' || B.Reference == 'H12'))"))
