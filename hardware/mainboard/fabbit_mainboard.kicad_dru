(version 1)

# Стойки мезонина H7, H8 (Würth WA-SMSI 9774090151): площадка 1 касается
# отверстия Ø3,7 самого футпринта. Так в рекомендации Würth.
(rule "Würth WA-SMSI: площадка у своего отверстия"
	(constraint hole_clearance (min 0mm))
	(condition "(A.memberOfFootprint('H7') && B.memberOfFootprint('H7')) || (A.memberOfFootprint('H8') && B.memberOfFootprint('H8'))"))

# Контур установки стоек заходит на MOD1 на 0,3 мм. Между корпусом стойки
# Ø5,1 и краем платы i9+ 0,65 мм. Проверить на образце i9+.
(rule "Стойки мезонина у модуля i9+"
	(constraint courtyard_clearance (min -0.5mm))
	(condition "((A.Reference == 'H7' || A.Reference == 'H8') && B.Reference == 'MOD1') || (A.Reference == 'MOD1' && (B.Reference == 'H7' || B.Reference == 'H8'))"))
