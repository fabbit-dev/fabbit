  "excluded": [
    "upstream embedded SPC700 IPL bytes",
    "upstream Gaussian silicon coefficients",
    "DSPn program/data hex",
    "all cartridge enhancement-chip RTL",
    "vendor PLL/RAM/controllers",
    "upstream board top/iosys/HDMI"
  ],
  "assets": {
    "ipl": "64 runtime user-supplied bytes; no embedded fallback",
    "gaussian": "512 runtime signed 12-bit coefficients; stream 1024 LE container bytes",
    "readiness": "Exact sequential address/last/coverage and backend ready required; stopped START restarts an incomplete selected upload while retaining the other asset's completed coverage",
    "provenance": "Runtime supplier verifies rights, source, image length and hash"
  },
  "tables": {
    "M_TAB": "Authored 65C816 micro-operations, 2048x52, not firmware",
    "MCODE0": "Authored SPC700 micro-operations, 2048x31, not IPL",
    "ALUFlags": "Instruction-control case decoders, not firmware",
    "DMA": "Transfer pattern and length logic constants",
    "DSP": "Scheduling/counter-mask tables only; Gaussian coefficients external",
    "PPU": "Fetch schedule and sprite-size logic tables"
  },
  "clock_contract": {
    "service": "4x related free master",
    "primitive": "BUFGCE whole-console clock hold, no ENABLE pause",
    "performance": "Deadline-aware whole-console hold; native intermediate read edge allowed, unresolved consumption edge blocked. Refresh/contention can still stretch wall time. Timers sized from timing parameters.",
    "stop": "run=0 requests quiesce; preserve last-edge sampling and drain, then stop_ack permits owner/config/assets change",
    "reset": "Global reset intentionally discards pending/unissued work; issued physical writes cannot be undone",
    "memory_reset": "Stopped-only physical SDRAM reinitialization, separate from global asset-invalidating reset; preserves IPL/coefficient coverage and blocks host/run until initialized again",
    "simulation_io": "Conditional ESMT M12L64322A(2S)-7 Rev1.0 CL2 tSACmax8ns, tOHmin2ns, tRCD21ns; ideal forwarded clock phase +2ns. Fitted grade, board delays, slew and routed I/O margins unverified"
  },
  "limitations": [
    "No proprietary BIOS/game compatibility proof",
    "No unconditional wall-clock two-master SDRAM deadline (refresh counterexample retained)",
    "No physical timing/route/combined-fit signoff"
  ],
  "reproduction": {
    "includes": [
      "gateware/profiles/retro/snes/rtl",
      "gateware/profiles/retro/snes/rtl/spc700"
    ],
    "simulation": "verilator --binary --assert --timing --timescale 1ns/1ps --top-module tb_retro_snes -f gateware/profiles/retro/snes/sources.f +incdir+gateware/profiles/retro/snes/rtl +incdir+gateware/profiles/retro/snes/rtl/spc700 gateware/sim/sdram_model.sv gateware/sim/tb_retro_snes.sv",
    "core_simulation_top": "tb_retro_snes_core",
