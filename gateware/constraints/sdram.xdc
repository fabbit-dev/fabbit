# SDRAM M12L64322A на модуле i9+ (litex-boards colorlight_i9plus.py): CS#, CKE и DQM разведены на
# постоянные уровни, A11 не подключён. Банки 15/16, 3,3 В.
set_property -dict { PACKAGE_PIN E14 IOSTANDARD LVCMOS33 SLEW FAST } [get_ports sdram_clk]
set_property -dict { IOSTANDARD LVCMOS33 SLEW FAST } [get_ports {sdram_a[*] sdram_ba[*] sdram_ras_n sdram_cas_n sdram_we_n sdram_dq[*]}]
set_property PACKAGE_PIN C20 [get_ports {sdram_a[0]}]
set_property PACKAGE_PIN C19 [get_ports {sdram_a[1]}]
set_property PACKAGE_PIN C13 [get_ports {sdram_a[2]}]
set_property PACKAGE_PIN F13 [get_ports {sdram_a[3]}]
set_property PACKAGE_PIN G13 [get_ports {sdram_a[4]}]
set_property PACKAGE_PIN G15 [get_ports {sdram_a[5]}]
set_property PACKAGE_PIN F14 [get_ports {sdram_a[6]}]
set_property PACKAGE_PIN F18 [get_ports {sdram_a[7]}]
set_property PACKAGE_PIN E13 [get_ports {sdram_a[8]}]
set_property PACKAGE_PIN E18 [get_ports {sdram_a[9]}]
set_property PACKAGE_PIN C14 [get_ports {sdram_a[10]}]
set_property PACKAGE_PIN D19 [get_ports {sdram_ba[0]}]
set_property PACKAGE_PIN B13 [get_ports {sdram_ba[1]}]
set_property PACKAGE_PIN A14 [get_ports sdram_ras_n]
set_property PACKAGE_PIN D14 [get_ports sdram_cas_n]
set_property PACKAGE_PIN D17 [get_ports sdram_we_n]
set_property PACKAGE_PIN F21 [get_ports {sdram_dq[0]}]
set_property PACKAGE_PIN E22 [get_ports {sdram_dq[1]}]
set_property PACKAGE_PIN F20 [get_ports {sdram_dq[2]}]
set_property PACKAGE_PIN E21 [get_ports {sdram_dq[3]}]
set_property PACKAGE_PIN F19 [get_ports {sdram_dq[4]}]
set_property PACKAGE_PIN D22 [get_ports {sdram_dq[5]}]
set_property PACKAGE_PIN E19 [get_ports {sdram_dq[6]}]
set_property PACKAGE_PIN D21 [get_ports {sdram_dq[7]}]
set_property PACKAGE_PIN K21 [get_ports {sdram_dq[8]}]
set_property PACKAGE_PIN L21 [get_ports {sdram_dq[9]}]
set_property PACKAGE_PIN K22 [get_ports {sdram_dq[10]}]
set_property PACKAGE_PIN M21 [get_ports {sdram_dq[11]}]
set_property PACKAGE_PIN L20 [get_ports {sdram_dq[12]}]
set_property PACKAGE_PIN M22 [get_ports {sdram_dq[13]}]
set_property PACKAGE_PIN N20 [get_ports {sdram_dq[14]}]
set_property PACKAGE_PIN M20 [get_ports {sdram_dq[15]}]
set_property PACKAGE_PIN B18 [get_ports {sdram_dq[16]}]
set_property PACKAGE_PIN D20 [get_ports {sdram_dq[17]}]
set_property PACKAGE_PIN A19 [get_ports {sdram_dq[18]}]
set_property PACKAGE_PIN A21 [get_ports {sdram_dq[19]}]
set_property PACKAGE_PIN A20 [get_ports {sdram_dq[20]}]
set_property PACKAGE_PIN B21 [get_ports {sdram_dq[21]}]
set_property PACKAGE_PIN C22 [get_ports {sdram_dq[22]}]
set_property PACKAGE_PIN B22 [get_ports {sdram_dq[23]}]
set_property PACKAGE_PIN G21 [get_ports {sdram_dq[24]}]
set_property PACKAGE_PIN G22 [get_ports {sdram_dq[25]}]
set_property PACKAGE_PIN H20 [get_ports {sdram_dq[26]}]
set_property PACKAGE_PIN H22 [get_ports {sdram_dq[27]}]
set_property PACKAGE_PIN J20 [get_ports {sdram_dq[28]}]
set_property PACKAGE_PIN J22 [get_ports {sdram_dq[29]}]
set_property PACKAGE_PIN G20 [get_ports {sdram_dq[30]}]
set_property PACKAGE_PIN J21 [get_ports {sdram_dq[31]}]
# команды и адрес — регистры в IOB (UG471): одна задержка вывода во всех сборках, фазу ищет sdram_eye
set_property IOB TRUE [get_ports {sdram_a[*] sdram_ba[*] sdram_ras_n sdram_cas_n sdram_we_n}]
